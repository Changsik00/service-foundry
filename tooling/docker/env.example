# tooling/docker/compose.yaml override 변수 템플릿
#
# compose 는 이 디렉토리의 .env 를 자동 로드한다.
# 사용하려면:  cp tooling/docker/env.example tooling/docker/.env
#
# 기본값은 apps/api/.env 와 일치하므로, 충돌이 없다면 .env 작성 없이 그대로 사용 가능.
# 아래 비밀번호 항목은 비워두면 compose 기본값이 적용된다 (개발 전용).

# --- PostgreSQL (apps/api 가 연결) ---
POSTGRES_USER=postgres
# POSTGRES_PASSWORD — 기본값 postgres (운영 시 반드시 변경). 비우면 기본 적용:
POSTGRES_PASSWORD=
POSTGRES_DB=service_foundry_dev
POSTGRES_PORT=5432
# 비-슈퍼유저 런타임 role 비밀번호 (spec-17-07). 앱은 이 role 로 접속해야 RLS 격리가 적용됨.
APP_RUNTIME_PASSWORD=app_runtime_dev

# --- apps/api DB 접속 (role 분리, spec-17-07) ---
# 런타임: 비-슈퍼유저 app_runtime (RLS 적용). 마이그레이션: owner postgres (RLS 우회).
#   DATABASE_URL=postgres://app_runtime:app_runtime_dev@localhost:5432/service_foundry_dev
#   DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/service_foundry_dev

# --- Redis (인프라 준비 — 앱 연동은 후속 spec) ---
REDIS_PORT=6379

# --- Observability (stub — 실제 구성은 spec-10-06) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100
# GRAFANA_ADMIN_PASSWORD — 기본값 admin. 비우면 기본 적용:
GRAFANA_ADMIN_PASSWORD=
