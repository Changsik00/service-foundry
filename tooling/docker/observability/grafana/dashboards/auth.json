{
  "uid": "auth-overview",
  "title": "Auth Overview",
  "tags": ["auth", "service-foundry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "로그인 시도/성공/실패 (rate per 1m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(auth_login_attempts_total[1m])",
          "legendFormat": "attempts"
        },
        {
          "refId": "B",
          "expr": "rate(auth_login_success_total[1m])",
          "legendFormat": "success"
        },
        {
          "refId": "C",
          "expr": "rate(auth_login_failure_total[1m])",
          "legendFormat": "failure"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "로그인 실패 누적",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "auth_login_failure_total", "legendFormat": "failure_total" }
      ]
    }
  ]
}
