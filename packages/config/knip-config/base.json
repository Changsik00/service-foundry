{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off",
    "catalog": "warn"
  },
  "ignoreDependencies": [
    "@repo/biome-config",
    "tsup",
    "drizzle-kit",
    "tailwindcss",
    "@nestjs/core",
    "@nestjs/testing",
    "@types/bcryptjs"
  ],
  "workspaces": {
    ".": {
      "entry": ["turbo/generators/config.ts", "tooling/scripts/**/run.ts"]
    },
    "packages/shared/*": {
      "entry": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/backend/*": {
      "entry": ["src/**/*.test.ts", "roundtrip.ts", "emit-span.ts"]
    },
    "packages/backend/settings": {
      "entry": ["src/**/*.test.ts"],
      "ignoreDependencies": ["@repo/errors", "@repo/utils"]
    },
    "packages/backend/auth-oauth": {
      "entry": ["src/**/*.test.ts"],
      "ignoreDependencies": ["@repo/backend-database"]
    },
    "packages/nestjs/*": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/frontend/*": {
      "entry": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/frontend/ui": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["@repo/validation", "next-themes"]
    },
    "apps/*": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.e2e.test.ts"]
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts", "src/**/*.e2e.test.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["@repo/tailwind-config"]
    }
  }
}
