{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env.*local", "pnpm-workspace.yaml", "pnpm-lock.yaml", ".nvmrc"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "../../biome.json", "../../packages/config/biome-config/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/config/typescript-config/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/config/vitest-config/**"],
      "env": ["DATABASE_URL", "DATABASE_MIGRATE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/config/vitest-config/**"]
    },
    "//#knip": {
      "inputs": [
        "knip.config.ts",
        "packages/config/knip-config/base.json",
        "apps/**",
        "packages/**",
        "tooling/**",
        "turbo/**",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#depcruise": {
      "inputs": [
        ".dependency-cruiser.cjs",
        "packages/config/depcruise-config/base.cjs",
        "apps/**",
        "packages/**"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
