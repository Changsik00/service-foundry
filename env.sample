  # ============================================================
  # .env.sample — 루트 환경변수 템플릿
  # 복사: cp .env.sample .env  →  실제 값 채우기
  # .env 는 .gitignore 에 포함 — 절대 커밋 금지
  # ============================================================

  # ─── Supabase ────────────────────────────────────────────────
  # 대시보드 > Settings > API
  SUPABASE_URL=https://<project-ref>.supabase.co
  SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # Publishable key
  SUPABASE_SECRET_KEY=sb_secret_...             # Secret key (서버 전용)
  # ⚠ Supabase 프로젝트 설정 (env 아님 — 대시보드):
  #   dev:  Authentication → Email → "Confirm email" OFF (e2e 결정론 + 메일 rate limit 회피)
  #   prod: 반드시 ON 복원 — OFF 면 임의 이메일로 즉시 계정 생성 가능 (스팸/도용 위험)
  #   코드는 양쪽 대응: ON 이면 SignupForm 이 "확인 이메일" 안내 (unverified_email 분기)
  #   주의: OFF(autoconfirm) 는 가입 즉시 email_verified=true 도장 — dev 에서 이 클레임으로
  #   분기하는 로직은 영원히 한쪽만 탄다 (거짓 GREEN). 검증 분기 테스트는 ON 환경에서만 유효

  # ─── apps/api ────────────────────────────────────────────────
  NODE_ENV=development
  PORT=2026
  LOG_LEVEL=info
  # 런타임 접속 = 비-슈퍼유저 app_runtime (RLS 테넌트 격리 적용 대상, spec-17-07).
  # superuser(postgres)로 접속하면 RLS 가 우회돼 격리 버그를 dev 에서 못 잡는다.
  # app_runtime role 은 compose initdb 가 생성(APP_RUNTIME_PASSWORD), GRANT 는 db:migrate(0012)가 적용.
  DATABASE_URL=postgresql://app_runtime:app_runtime_dev@localhost:5432/service_foundry_dev
  # 마이그레이션 전용 = owner/superuser (DDL·RLS 우회 필요).
  DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/service_foundry_dev
  HTTP_CLIENT_BASE_URL=http://localhost:9999
  AUTH_MODE=supabase                            # native | firebase | supabase

  # ─── 공통 (web · api) ───────────────────────────────────
  API_BASE_URL=http://localhost:2026